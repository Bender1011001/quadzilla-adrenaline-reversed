# Ghidra projects (large, generated)
ghidra_project/
*.gpr
*.rep/
gh_tmp/

# Decompiled APK (too large, copyrighted)
decompiled/

# IDE
.vscode/

# Vendor / proprietary binaries — NEVER commit these.
# Patterns are deliberately unanchored so they apply at the repo root too,
# not just inside analysis/. The working tree routinely holds the vendor's
# installers, firmware images and libraries (DataMaster-BT.exe,
# FirmwareUpdater-BT.exe, S03V*_flash.bin, C1Sizer.ocx, DTCDB.sqlite, ...);
# committing any of them would redistribute copyrighted software.
*.exe
*.dll
*.ocx
*.bin
*.hex
*.apk
*.Smt
*.7z
*.zip
*.sqlite
*.manifest
# Vendor documentation bundles (DataMaster/MasterTune help + license files).
# NOTE: do not add a `Docs/` pattern here — core.ignorecase is true on
# Windows, so it would also match this repo's tracked `docs/` directory.
*.chm
*.rtf
*.url
/Bin/

# Python
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store
